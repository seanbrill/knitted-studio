# Copy to .env (git-ignored). Read by the site build and by `npm run release`.
#
# A FileFreak key limited to READING the release folder. The site build uses it to
# list the published installers; it never reaches a browser.
KNITTED_RELEASE_DOWNLOAD_KEY=

# A FileFreak key limited to the release folder, allowed files:write. `npm run release`
# (on a Mac) uploads each version's installers with it. SECRET.
FILEFREAK_KEY=

# The SITE key: made for the app that owns the site, NOT limited to a folder, allowed
# sites:deploy (FileFreak refuses a folder key for sites). `npm run release` deploys the
# site with it once the installers are up, so the Download page and the apps' update
# check list the new version without waiting for the pipeline. SECRET.
FILEFREAK_SITE_KEY=

# The site to deploy, if not "knitted" (knitted.filefreak.page, with knitted.studio
# pointed at it).
# KNITTED_SITE_NAME=knitted
