# Environment for the "knitted release" pipeline. Set these in EZPIPELINE, in the
# scope of the group the pipeline sits in. Never commit real values.

# Where to clone knitted from (EZPIPELINE needs a read-only deploy key for it).
KNITTED_REPO_URL=git@github.com:seanbrill/knitted-studio.git
# KNITTED_BRANCH=main

# The RELEASE key: may write files (files:write) in the folder that holds the release
# folder. It may be limited to that folder. SECRET.
FILEFREAK_KEY=

# The SITE key: made for the app that owns the site, NOT limited to a folder, allowed
# sites:deploy. FileFreak refuses a folder key for sites. Left out, FILEFREAK_KEY is
# tried, and the run stops at Preflight if it cannot deploy. SECRET.
FILEFREAK_SITE_KEY=

# The release folder in FileFreak, as the write key sees it. Each version goes in a
# v<version> folder inside it. The folder must be public so the download links work.
KNITTED_RELEASE_FOLDER=ff:/knitted/releases

# The site to deploy (name.filefreak.page, with knitted.studio pointed at it).
KNITTED_SITE_NAME=knitted

# The READ-ONLY key for the same folder. The site build uses it to list releases.
# SECRET. It is only used while building and is not in the site.
KNITTED_RELEASE_DOWNLOAD_KEY=
