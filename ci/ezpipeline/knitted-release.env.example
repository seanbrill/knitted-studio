# Environment for the "knitted release" pipeline, which checks the code, publishes a new
# version's installers, and builds and deploys the site. Set these in EZPIPELINE, in the
# scope of the group the pipeline sits in. Never commit real values.

# Where to clone knitted from (EZPIPELINE needs a read-only deploy key for it).
KNITTED_REPO_URL=git@github.com:seanbrill/knitted-studio.git
# KNITTED_BRANCH=main

# The SITE key: made for the app that owns the site, NOT limited to a folder, allowed
# sites:deploy. FileFreak refuses a folder key for sites. SECRET.
FILEFREAK_SITE_KEY=

# The site to deploy (name.filefreak.page, with knitted.studio pointed at it).
KNITTED_SITE_NAME=knitted

# The READ-ONLY key for the release folder. The site build uses it to list releases.
# SECRET. It is only used while building and is not in the site.
KNITTED_RELEASE_DOWNLOAD_KEY=

# The release folder's WRITE key (files:write, limited to the release folder), the one
# npm run release uses. A new version's installers go up with it; a run with no new
# version does not use it. SECRET.
FILEFREAK_KEY=
