{
  "name": "@knitted/studio",
  "version": "0.1.45",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "node ../../scripts/next-build.mjs",
    "start": "next start -p 4100",
    "desktop:dev": "node ../../scripts/stage-desktop.mjs && node electron/launch.mjs",
    "desktop:smoke": "node ../../scripts/stage-desktop.mjs && node electron/launch.mjs --prod --smoke",
    "desktop:pack": "node ../../scripts/app-icons.mjs && electron-builder --dir",
    "desktop:dist": "node ../../scripts/app-icons.mjs && electron-builder"
  },
  "dependencies": {
    "@knitted/agent": "*",
    "@knitted/core": "*",
    "@knitted/engine": "*",
    "@knitted/fonts": "*",
    "@knitted/render": "*",
    "@knitted/social": "*",
    "@knitted/ui": "*",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0"
  },
  "main": "electron/main.mjs",
  "author": "knitted.studio contributors",
  "description": "Make social posts, ads and web graphics from reusable brand Patterns.",
  "homepage": "https://knitted.studio",
  "desktopName": "knitted.desktop"
}
